# Copy to .env (root, and/or per-app .env.local) and fill in real values. Never commit secrets.

# --- Database (used by packages/db migration/seed scripts) ---
# Use the Supabase SESSION POOLER connection string, not the direct connection host —
# direct connections on the free tier are IPv6-only and many networks can't reach them.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> "Session pooler"
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase project (used by both Next.js apps) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Server-side only. NEVER exposed to any frontend bundle. Used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Google Maps (public website: map on property detail, "use my location") ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<google-maps-browser-key>

# --- Public site base URL (used to build stable QR-code property URLs) ---
NEXT_PUBLIC_SITE_URL=https://example.com
